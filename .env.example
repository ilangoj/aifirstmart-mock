# Every setting the running system reads (STANDARD.md section 7). Copy to .env and fill in; .env is never committed.
# `python afm.py deploy --target docker` creates .env from this file, with fresh random secrets, when .env is missing.
# An empty value means "not set".

# development | production. In production the server refuses to start with missing or sample secrets.
AFM_ENV=production
# Which built pages to serve, and whether to serve the backend API at /api
AFM_EDITIONS=training,platform
AFM_ENABLE_API=true

# --- Secrets: keep real values only in .env or the host's secret store ---
# 48+ random characters:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AFM_JWT_SECRET=
# A Fernet key:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AFM_VAULT_MASTER_KEY=
AFM_PLATFORM_ADMIN_EMAIL=admin@aifirstmart.example
AFM_PLATFORM_ADMIN_PASSWORD=

# --- Optional ---
# SQLite file for the catalogue; in Docker it is set to /data/afm.sqlite (a persistent volume)
AFM_DB_PATH=
# Google sign-in OAuth client ids, comma-separated
AFM_GOOGLE_CLIENT_IDS=
# Port on this computer for docker compose (the container always listens on 8080)
AFM_HOST_PORT=8080
